{
  "name": "type-key",
  "version": "1.0.0",
  "description": "Monkeyterm — terminal typing test powered by Bun + OpenTUI",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile monkeyterm",
    "build:pkg": "bun build ./src/index.ts --compile --outfile monkeyterm",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit --pretty"
  },
  "keywords": [
    "typing",
    "terminal",
    "monkeytype",
    "monkeyterm",
    "opentui",
    "tui",
    "type-key"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@crafter/charts": "^0.2.4",
    "@opentui/core": "^0.1.103"
  }
}
